# ==============================================================================
# Open WebUI (fluAi) - Environment Configuration
# ==============================================================================

# Port to expose Open WebUI on the host (Default: 8080)
PORT=8080

# Secret key for JWT session tokens (Leave blank to auto-generate)
WEBUI_SECRET_KEY=

# Ollama API URL (Default: http://ollama:11434 if using docker service)
OLLAMA_BASE_URL=http://ollama:11434

# OpenAI API Key (Optional: Provide if using OpenAI models or Whisper STT / TTS)
OPENAI_API_KEY=

# OpenAI API Base URL (Optional: For custom OpenAI-compatible endpoints)
OPENAI_API_BASE_URL=

# Dify / Diffy FastMCP Skills Server URL
# Cloud URL: https://diffy-ax7l.onrender.com | Local Diffy: http://localhost:3001 (or http://host.docker.internal:3001 in Docker)
DIFY_API_BASE_URL=https://diffy-ax7l.onrender.com

# Auto-enable skills use for every user request by default
ENABLE_DEFAULT_SKILLS_PROMPT=true
DEFAULT_SKILLS_USER_PROMPT=[INSTRUCTION: You have access to a dynamic skills library via MCP tools (list_skills, get_skill, list_skill_files). For every user request, first discover available skills with list_skills, select relevant skills, and retrieve instructions with get_skill before answering. If no skill matches or get_skill returns SKILL_NOT_FOUND, reply strictly with: "i have not record with your answer". Never answer from general knowledge when no skill matches.]
