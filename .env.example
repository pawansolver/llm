# ==============================================================================
# Open WebUI (fluAi) - Environment Configuration
# ==============================================================================

# Port to expose Open WebUI on the host (Default: 8080)
PORT=8080

# Secret key for JWT session tokens (Leave blank to auto-generate)
WEBUI_SECRET_KEY=

# Ollama API URL (Default: http://ollama:11434 if using docker service)
OLLAMA_BASE_URL=http://ollama:11434

# OpenAI API Key (Optional: Provide if using OpenAI models or Whisper STT / TTS)
OPENAI_API_KEY=

# OpenAI API Base URL (Optional: For custom OpenAI-compatible endpoints)
OPENAI_API_BASE_URL=
